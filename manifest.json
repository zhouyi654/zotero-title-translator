{
  "manifest_version": 2,
  "name": "Zotero 标题翻译",
  "version": "0.3.4",
  "description": "在“标题（中文）”列显示中文标题；支持所选条目、所选分类、整个文献库以及新导入文献的可选自动翻译。",
  "author": "zhouyi654",
  "applications": {
    "zotero": {
      "id": "zotero-title-translator@zhouyi654.github.io",
      "update_url": "https://github.com/zhouyi654/zotero-title-translator/releases/latest/download/updates.json",
      "strict_min_version": "9.0",
      "strict_max_version": "9.0.*"
    }
  },
  "homepage_url": "https://github.com/zhouyi654/zotero-title-translator",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
